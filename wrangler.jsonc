{
  "name": "konfigurator-be",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "konfigurator", "database_id": "local-dev" }
  ],
  "r2_buckets": [
    { "binding": "ASSETS", "bucket_name": "konfigurator-assets" }
  ],
  "vars": { "JWT_SECRET": "dev-secret-change-me" }
}
