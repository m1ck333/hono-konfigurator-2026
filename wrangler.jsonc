{
  "name": "konfigurator-be",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "konfigurator", "database_id": "cba63bed-91f6-4fb5-83b6-ac44ea92c056" }
  ],
  "r2_buckets": [
    { "binding": "ASSETS", "bucket_name": "konfigurator-assets" }
  ],
  // Inquiry email via the existing Algreen mailbox (Loopia SMTP, worker-mailer over TCP socket).
  // SMTP_PASS is a secret (wrangler secret put SMTP_PASS). INQUIRY_TO is the test address for now;
  // switch to info@algreen.rs once verified.
  "vars": {
    "SMTP_HOST": "mailcluster.loopia.se",
    "SMTP_PORT": "465",
    "SMTP_USER": "upit@algreen.rs",
    "INQUIRY_FROM": "upit@algreen.rs",
    "INQUIRY_TO": "m1ck33kc1m@gmail.com"
  },
  "observability": { "enabled": true }
}
